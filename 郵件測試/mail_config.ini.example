[mail]
; ================== 寄信設定檔說明 ==================
; 用途：給「寄送信件測試.ahk」與主流程收尾通知使用。
; 注意：密碼請用「應用程式密碼」，不要用一般登入密碼或備用碼。
;
; 常見服務設定（通常值）：
; 1) Gmail:        host=smtp.gmail.com      port=587  use_ssl=1
; 2) Outlook/365:  host=smtp.office365.com  port=587  use_ssl=1
; 3) Yahoo:        host=smtp.mail.yahoo.com port=465  use_ssl=1
;
; 參數 1：smtp_host
; 說明：SMTP 伺服器主機名稱。
; 常見值：smtp.gmail.com / smtp.office365.com / smtp.mail.yahoo.com
smtp_host=smtp.gmail.com

; 參數 2：smtp_port
; 說明：SMTP 連接埠。
; 常見值：587（STARTTLS，最常見）或 465（SSL）
smtp_port=587

; 參數 3：smtp_user
; 說明：SMTP 登入帳號，通常是完整信箱。
; 常見值：your_account@gmail.com
smtp_user=your_account@gmail.com

; 參數 4：smtp_pass
; 說明：SMTP 密碼。
; 建議：Gmail 請填 16 碼「應用程式密碼」（可含空白或不含空白皆可）。
; 例如：abcd efgh ijkl mnop
smtp_pass=your_app_password

; 參數 5：from
; 說明：寄件者信箱。
; 常見值：與 smtp_user 相同。
from=your_account@gmail.com

; 參數 6：to
; 說明：收件者信箱。
; 常見值：先填自己，測試成功後再改為正式收件者。
to=your_receiver@gmail.com

; 參數 7：subject_prefix
; 說明：信件主旨前綴，方便過濾通知。
; 常見值：LRMCAI / 全自動監測
subject_prefix=LRMCAI

; 參數 8：use_ssl
; 說明：是否啟用加密連線。
; 常見值：1（建議）
; 可用值：1=啟用，0=停用
use_ssl=1

; ================== 填寫建議 ==================
; - 第一輪先用自己的信箱寄給自己測試。
; - 如果失敗，先確認：
;   (1) 帳號已開啟兩步驟驗證
;   (2) smtp_pass 使用應用程式密碼
;   (3) host/port/use_ssl 與服務商一致
