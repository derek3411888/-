{
	# Browsers do not send an SNI host name for a literal IP address. Use the
	# public IP certificate only as the no-SNI default; named hosts still select
	# their own certificate normally.
	default_sni {$PUBLIC_IP_ADDRESS}
}

(control_site) {
	encode zstd gzip

	@internal path /internal/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	reverse_proxy api:3000
}

{$PUBLIC_HOSTNAME} {
	import control_site
}

# Company networks often block dynamic-DNS categories. A static public IPv4
# can use Let's Encrypt's short-lived public IP certificate as an independent
# HTTPS entry point without changing the device API or SRT addresses.
{$PUBLIC_IP_ADDRESS} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	import control_site
}
