PUBLIC_HOSTNAME=example.asuscomm.com
PUBLIC_IP_ADDRESS=203.0.113.10
# Optional named Cloudflare Tunnel / same-backend direct entry.
PUBLIC_URL=
ALLOWED_ORIGINS=
DIRECT_HOSTNAME=
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_AUDIENCE=
CODEX_ALLOWED_EMAILS=
CODEX_LOGIN_URL=
CLOUDFLARED_TOKEN_FILE=./secrets/cloudflared-token
PUBLIC_SRT_HOST=203.0.113.10
LOCAL_SRT_HOST=192.168.0.10
PUBLIC_SRT_PORT=8890
LIVE_PUBLISHER_GRACE_SECONDS=600
FORMAL_MEDIA_ENABLED=false
DATA_ROOT_HOST=D:/WutheringControlServer/data
BACKUP_ROOT_HOST=E:/WutheringControlBackups
POSTGRES_PASSWORD=replace-with-random-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
LIVE_TOKEN_SECRET=replace-with-at-least-32-random-characters
LIVE_SRT_PASSPHRASE=replace-with-10-to-79-random-characters
MIN_FREE_GB=20
SESSIONS_PER_DEVICE=5
FIRESTORE_IMPORT_ENABLED=true
# Set true only AFTER the existing migration has reached unfrozen primary and
# every device has been accepted on selfhost_only. Does not force a cutover.
SELFHOST_ONLY=false
# Optional two-device company Pages bridge. Does not re-enable legacy imports.
# New request IDs/epochs only; central Postgres owns all counters. 60s interval.
COMPANY_BRIDGE_ENABLED=false
FIRESTORE_PROJECT_ID=ww-control-a3988
FIRESTORE_API_KEY=replace-with-existing-firestore-web-api-key
FIRESTORE_COLLECTION=ahk_clients
SERVER_IMAGE_TAG=current
