[remote_control]
; 0=停用, 1=啟用
enabled=0

; Firestore project ID 與 Web API key
project_id=ww-control-a3988
api_key=AIzaSyDqWHdBixVQPt4OiTi50hseInFxPtk0hf0

; Firestore collection 名稱
collection=ahk_clients

; 第一次可留空，腳本會自動生成（A_ComputerName + MAC）
uid=

; 裝置別名（建議填：主機A/主機B、客廳機、工作機）
; 若 display_name 留空，會自動組成：device_alias@電腦名-短碼
device_alias=

; 顯示名稱（下拉選單可見）
; 可手動固定，例如：主機A-鳴潮、主機B-鳴潮
; 若留空，會自動使用：
; 1) 有 device_alias -> device_alias@電腦名-短碼
; 2) 無 device_alias -> 電腦名-短碼
display_name=

; 心跳/輪詢/HTTP timeout（毫秒）
heartbeat_interval_ms=90000
poll_interval_ms=10000
http_timeout_ms=2500

; 正常完整結束會保留 OFFLINE 裝置狀態，但刪除雲端最新快照。
; 異常終止、系統關機與流程重啟交接會保留最後快照供診斷。
clear_snapshot_on_clean_exit=1

; 命令去重（可留 0）
last_nonce=0

; 遠端設定同步狀態（第一次使用保持預設，不需手動修改）
last_settings_seen_revision=0
applied_settings_revision=0
last_settings_ack_revision=0
last_settings_ack_result=
last_settings_ack_detail=
last_settings_ack_applied=0
last_settings_ack_at=0

[self_hosted]
; 全新電腦直接使用固定公網 HTTPS 自動註冊；伺服器仍可透過 discovery 更新。
; 正式環境只接受 HTTPS；localhost 測試可使用 HTTP。
server_url=https://220.135.218.98
mode=shadow
epoch=
firestore_fallback_until=0
; 裝置 token 由程式產生並以目前 Windows 使用者的 DPAPI 加密，請勿手動修改。
device_token_dpapi=
; 每段 HTTPS 續傳上限；直播期間會自動降到 2 Mbps。
upload_limit_mbps=8
; economy=720p12/1.5Mbps、balanced=720p30/3.5Mbps、smooth=720p60/6Mbps。
live_quality_profile=balanced

[restart_tracking]
; 可由新版控制網站調整，允許 1～50
max_restart_count=10

[runtime_diagnostics]
; 圖片集中在「程式資料夾\診斷快照」；latest.jpg 會覆寫，錯誤圖依份數保留。
; 遠端控制啟用時，最新畫面會同步到獨立 media 文件。
enabled=1
snapshot_interval_sec=60
error_keep_count=30
snapshot_max_width=640
jpeg_quality=45
; 網路影片功能暫停實作；舊設定會自動改為 0
video_preview_enabled=0
